FROM lzk4-jammy-tools:local
RUN apt-get -o Acquire::Retries=3 -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=25 update && \
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=3 -o Acquire::ForceIPv4=true -o Acquire::http::Timeout=25 install -y --no-install-recommends qemu-system-arm && \
    rm -rf /var/lib/apt/lists/*
